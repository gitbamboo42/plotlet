{
  "version": "0.1.0",
  "linewidth": 2.0,
  "marker_size": 5,
  "marker_stroke_width": 1.4,
  "cmap": "viridis",
  "size": {
    "data_width": 524,
    "data_height": 322,
    "data_diameter": 320,
    "margin_floor": {"top": 0, "right": 0, "bottom": 0, "left": 0},
    "outer_margin": {"top": 4, "right": 4, "bottom": 4, "left": 4}
  },
  "figure": {
    "background": "#fff",
    "svg_root_font_size": 11
  },
  "font": {
    "family": "DejaVu Sans, Bitstream Vera Sans, Verdana, Arial, sans-serif",
    "tick_size": 13,
    "label_size": 14,
    "title_size": 16,
    "subtitle_size": 13,
    "caption_size": 11,
    "linespacing": 1.2,
    "color": "#000"
  },
  "pad": {
    "title": 13,
    "subtitle": 4,
    "xlabel": 8,
    "ylabel": 8,
    "caption": 8
  },
  "frame": {
    "color": "#000000",
    "linewidth": 1.0,
    "tick_length": 4.5,
    "minor_tick_ratio": 0.55,
    "tick_pad": 5,
    "tick_direction": "out",
    "tick_marks": true,
    "tick_density_x_px": 65,
    "tick_density_y_px": 40,
    "x_side": "bottom",
    "y_side": "left",
    "spine_top": true,
    "spine_right": true,
    "spine_bottom": true,
    "spine_left": true
  },
  "grid": {
    "color": "#b0b0b0",
    "linewidth": 0.7,
    "dasharray": "2,3",
    "minor_linewidth": 0.5,
    "minor_dasharray": "2,4",
    "default_on": false
  },
  "sectors": {
    "label_pad": 5,
    "label_size": 13
  },
  "linestyles": {
    "-":  null,
    "--": "6,3",
    ":":  "1,3",
    "-.": "6,3,1,3"
  },
  "scale": {
    "x_expand": [0.05, 0.05],
    "y_expand": [0.05, 0.05],
    "category_padding": 0.2,
    "category_split_gap": 6.0
  },
  "raster": {
    "dense_threshold": 20000,
    "dense_supersample": 3,
    "dense_tolerance": 0.5,
    "image_max_rects": 10000,
    "oversample": 2
  },
  "legend": {
    "label_size": 13,
    "header_size": 14,
    "row_height": 19,
    "pad_x": 11,
    "pad_y": 8,
    "swatch_width": 25,
    "swatch_label_gap": 6,
    "max_swatch_radius": 9.5,
    "max_swatch_stroke": 4,
    "header_pad": 4,
    "gradient_label_pad": 4,
    "background": "#ffffff",
    "alpha": 0.92,
    "border_offset": 8,
    "gradient_width": 19,
    "gradient_height": 70,
    "gradient_length": 140,
    "gradient_n_stops": 32,
    "section_gap": 11,
    "column_gap": 18
  },
  "layout": {
    "gap": 8,
    "gap_x": null,
    "gap_y": null,
    "legend_gap": 13,
    "attach_gap": 5
  },
  "scatter":    {"size": 3.5, "alpha": 0.85},
  "bar":        {"alpha": 1},
  "hist":       {"alpha": 1, "gap": 1.3},
  "fill":       {"alpha": 0.3},
  "refline":    {"color": "#000000", "linewidth": 1.0},
  "refspan":    {"color": "#000000", "alpha": 0.2},
  "errorbar":   {"color": "#222222", "linewidth": 1.6, "capsize": 5},
  "dendrogram": {"color": "#1a1a1a", "linewidth": 0.95,
                 "parent_height": 0.25, "parent_gap": 0.10},
  "qq":         {"refline_color": "#888"},
  "heatmap":    {"absent_fill": "#eeeeee", "annot_size": 10},
  "text":       {"size": 13, "color": "#222222",
                 "bbox": {"facecolor": "#ffffff", "edgecolor": "none",
                          "pad": 4.0, "alpha": 0.85, "linewidth": 0.8}},
  "annotate":   {"arrow_head": 9.3, "arrow_width": 1.2, "arrow_base_ratio": 0.45}
}
